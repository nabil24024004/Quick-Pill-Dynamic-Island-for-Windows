{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick Pill",
  "version": "6.0.0",
  "identifier": "com.neosparkx.quickpill",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Quick Pill",
        "width": 800,
        "height": 600,
        "x": 0,
        "y": 0,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NeoSparkX",
    "homepage": "https://quickpill.neosparkx.com/",
    "copyright": "Copyright (c) 2026 Abrar Nabil / NeoSparkX",
    "license": "MIT",
    "shortDescription": "Dynamic Island for Windows 10 & 11",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "tsp": true,
      "signCommand": {
        "cmd": "node",
        "args": [
          "-e",
          "const f=require(/fs/.source),p=require(/path/.source),c=require(/child_process/.source);let d=process.cwd(),s;for(let i=0;i<7;i++){const x=p.join(d,/scripts/.source,/sign-windows.ps1/.source);if(f.existsSync(x)){s=x;break;}d=p.dirname(d);}if(!s){console.error(/Missing sign-windows.ps1/.source);process.exit(1);}const r=c.spawnSync(/powershell/.source,[/-NoProfile/.source,/-ExecutionPolicy/.source,/Bypass/.source,/-File/.source,s,/-TargetPath/.source,process.argv[1]],{stdio:/inherit/.source});process.exit(r.status??1);",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
