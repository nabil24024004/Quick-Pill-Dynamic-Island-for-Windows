{
  "name": "quick-pill",
  "productName": "Quick Pill",
  "version": "5.2.0",
  "description": "A Dynamic Island for Windows",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "electron:dev": "electron-forge start",
    "build": "electron-builder --win",
    "electron:build": "electron-builder --win",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build-win": "electron-builder --win",
    "publish": "electron-forge publish",
    "update:manifest": "node scripts/generate-manifest.js",
    "lint": "echo \"No linting configured\""
  },
  "build": {
    "appId": "com.neosparkx.quickpill",
    "productName": "Quick Pill",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "src/assets/icons/icon.ico",
      "uninstallerIcon": "src/assets/icons/icon.ico",
      "installerHeaderIcon": "src/assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Pill"
    }
  },
  "keywords": [],
  "author": {
    "name": "Abrar Nabil",
    "email": "abrar@neosparkx.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-wix": "^7.8.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^38.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.575.0",
    "node-powershell": "^5.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "allowScripts": {
    "electron@38.7.2": true,
    "esbuild@0.21.5": true,
    "@bitdisaster/exe-icon-extractor@1.0.10": true,
    "electron-winstaller": true
  }
}